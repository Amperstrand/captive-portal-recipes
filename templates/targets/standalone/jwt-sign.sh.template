#!/bin/sh
# captive portal auto-login script for %%NAME%%
# Generated by recipe-compiler from recipe: %%ID%%
# Target: standalone (plain curl + awk)
# NOTE: This auth_type is not yet fully implemented for standalone target.
# This is free software, licensed under the GNU General Public License v3.
# shellcheck disable=all

export LC_ALL=C
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin"

# Configuration
PORTAL_DOMAIN="%%DOMAIN%%"
USER_AGENT="Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Mobile Safari/537.36"

# Auto-detect captive portal URL or use argument
if [ -n "${1}" ]; then
	CAPTIVE_URL="${1}"
else
	CAPTIVE_URL="http://captive.apple.com"
fi

# Travelmate compatibility shim for standalone execution
trm_fetch="curl"
trm_fetchparm="-sS -L --max-time 10"
trm_useragent="${USER_AGENT}"
trm_awkcmd="awk"
trm_jsoncmd="jsonfilter"
trm_lookupcmd="nslookup"
trm_domain="${PORTAL_DOMAIN}"
trm_captiveurl="${CAPTIVE_URL}"
trm_bver="standalone"

%%CREDENTIAL_SETUP%%

trm_domain="%%DOMAIN%%"
if ! "${trm_lookupcmd}" "${trm_domain}" >/dev/null 2>&1; then
%%FALLBACK_DOMAINS%%
fi

# check openssl availability for JWT signing
#
if ! command -v openssl >/dev/null 2>&1; then
	echo "error: openssl required for JWT signing - install openssl package" >&2
	exit 1
fi

# base64url encode helper
#
b64url() { printf '%s' "$1" | openssl base64 -e -A | tr '+/' '-_' | tr -d '='; }

# build JWT token
#
jwt_header='%%JWT_HEADER%%'
jwt_payload='%%JWT_PAYLOAD%%'
jwt_secret='%%JWT_SECRET%%'

jwt_h64="$(b64url "${jwt_header}")"
jwt_p64="$(b64url "${jwt_payload}")"
jwt_sign_input="${jwt_h64}.${jwt_p64}"
jwt_signature="$(printf '%s' "${jwt_sign_input}" | openssl dgst -sha256 -hmac "${jwt_secret}" -binary | openssl base64 -e -A | tr '+/' '-_' | tr -d '=')"
jwt_token="${jwt_sign_input}.${jwt_signature}"

# authenticate
#
%%JWT_REQUEST%%

%%SUCCESS_CHECK%%
