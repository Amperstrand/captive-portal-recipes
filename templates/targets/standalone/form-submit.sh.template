#!/bin/sh
# captive portal auto-login script for %%NAME%%
# Generated by recipe-compiler from recipe: %%ID%%
# Target: standalone (plain curl + awk)
# This is free software, licensed under the GNU General Public License v3.
# shellcheck disable=all

set -e

%%URLENCODE_FUNC%%

export LC_ALL=C
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin"

# Configuration
PORTAL_DOMAIN="%%DOMAIN%%"
USER_AGENT="Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Mobile Safari/537.36"

# Auto-detect captive portal URL or use argument
if [ -n "${1}" ]; then
	CAPTIVE_URL="${1}"
else
	CAPTIVE_URL="http://captive.apple.com"
fi

# Travelmate compatibility shim for standalone execution
trm_fetch="curl"
trm_fetchparm="-sS -L --max-time 10"
trm_useragent="${USER_AGENT}"
trm_awkcmd="awk"
trm_jsoncmd="jsonfilter"
trm_lookupcmd="nslookup"
trm_domain="${PORTAL_DOMAIN}"
trm_captiveurl="${CAPTIVE_URL}"
trm_bver="standalone"

%%CREDENTIAL_SETUP%%

trm_domain="%%DOMAIN%%"
if ! "${trm_lookupcmd}" "${trm_domain}" >/dev/null 2>&1; then
%%FALLBACK_DOMAINS%%
fi

# fetch form page and extract form action
#
form_html="$("${trm_fetch}" ${trm_fetchparm} --user-agent "${trm_useragent}" "%%FORM_PAGE_URL%%")"
form_action="$(printf "%s" "${form_html}" 2>/dev/null | "${trm_awkcmd}" 'match(tolower($0),/action="[^"]*"/){val=substr($0,RSTART+8,RLENGTH-9); print val; exit}' 2>/dev/null)"
[ -z "${form_action}" ] && form_action="%%FORM_ACTION_DEFAULT%%"

# extract hidden fields from form
#
hidden_fields="$(printf "%s" "${form_html}" 2>/dev/null | "${trm_awkcmd}" '
match(tolower($0),/<input[^>]*type="hidden"[^>]*>/){
	line=substr($0,RSTART,RLENGTH)
	nam=""
	val=""
	if(match(line,/name="[^"]*"/)){nam=substr(line,RSTART+6,RLENGTH-7)}
	if(match(line,/value="[^"]*"/)){val=substr(line,RSTART+7,RLENGTH-8)}
	if(nam!=""){printf "%s=%s&",nam,val}
}')"

# submit form with credentials
#
post_data="${hidden_fields}%%USERNAME_FIELD%%=${username}&%%PASSWORD_FIELD%%=${password}%%EXTRA_FIELDS%%"
raw_html="$("${trm_fetch}" ${trm_fetchparm} --user-agent "${trm_useragent}" --header "Content-Type:application/x-www-form-urlencoded" --data "${post_data}" "%%SUBMIT_URL%%")"
%%SUCCESS_CHECK%%
