# shellcheck disable=all

set -e

export LC_ALL=C
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin"

# Configuration
PORTAL_DOMAIN="%%DOMAIN%%"
USER_AGENT="Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Mobile Safari/537.36"

# Auto-detect captive portal URL or use argument
if [ -n "${1}" ]; then
	CAPTIVE_URL="${1}"
else
	CAPTIVE_URL="http://captive.apple.com"
fi

# Travelmate compatibility shim for standalone execution
trm_fetch="curl"
trm_fetchparm="-sS -L --max-time 10"
trm_useragent="${USER_AGENT}"
trm_awkcmd="awk"
trm_jsoncmd="jsonfilter"
trm_lookupcmd="nslookup"
trm_domain="${PORTAL_DOMAIN}"
trm_captiveurl="${CAPTIVE_URL}"
trm_bver="standalone"

%%CREDENTIAL_SETUP%%

trm_domain="%%DOMAIN%%"
if ! "${trm_lookupcmd}" "${trm_domain}" >/dev/null 2>&1; then
%%FALLBACK_DOMAINS%%
fi

# get redirect chain and extract grant URL from query parameters
#
redirect_url="$("${trm_fetch}" ${trm_fetchparm} --user-agent "${trm_useragent}" --write-out "%{redirect_url}" --output /dev/null "${trm_captiveurl}")"
base_grant_url="$(printf "%s" "${redirect_url}" 2>/dev/null | "${trm_awkcmd}" '
{
	n = split($0, parts, "&")
	for (i = 1; i <= n; i++) {
		pos = index(parts[i], "%%GRANT_URL_PARAM%%=")
		if (pos > 0) {
			val = substr(parts[i], pos + %%GRANT_URL_PARAM_LEN%%)
			gsub(/%25/, "%", val)
			gsub(/%3[Aa]/, ":", val)
			gsub(/%2[Ff]/, "/", val)
			print val
			exit
		}
	}
}')"
[ -z "${base_grant_url}" ] && exit 2

case "${base_grant_url}" in
	http://*|https://*) ;;
	*) exit 2 ;;
esac

raw_html="$("${trm_fetch}" ${trm_fetchparm} --user-agent "${trm_useragent}" %%GRANT_METHOD_OPT%%"${base_grant_url}?continue_url=%%CONTINUE_URL%%&duration=%%DURATION%%")"
%%SUCCESS_CHECK%%
