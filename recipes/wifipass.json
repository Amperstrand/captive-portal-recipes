{
  "id": "wifipass",
  "name": "WiFiPass.org Portal",
  "travelmate_domain": "wifipass.org",
  "fallback_domains": [],
  "auth_type": "cookie-chain",
  "credentials": "none",
  "version": "1.0.0",
  "schema_version": 2,
  "sources": [
    {
      "project": "manual-research",
      "handler": "generic",
      "license": "MIT",
      "note": "Speculative cookie-chain template for wifipass.org"
    }
  ],
  "match": {
    "ssids": [],
    "domains": [],
    "paths": [],
    "body_contains": [],
    "priority": 50
  },
  "params": {
    "init_url": "https://wifipass.org/login",
    "cookie_extract_pattern": "/PHPSESSID/{print $NF}",
    "submit_url": "https://wifipass.org/submit",
    "post_data": "session=${session_token}&accept=1",
    "extra_headers": "",
    "success_check_type": "contains_string",
    "success_check_string": "success"
  }
}
