{
  "id": "mikrotik-chap",
  "name": "MikroTik Hotspot CHAP",
  "travelmate_domain": "hotspot.local",
  "fallback_domains": [],
  "auth_type": "chap-md5",
  "credentials": "username_password",
  "version": "1.0.0",
  "schema_version": 2,
  "sources": [
    {
      "project": "manual-research",
      "handler": "generic",
      "license": "MIT",
      "note": "Generic MikroTik CHAP-MD5 pattern"
    }
  ],
  "match": {
    "ssids": [],
    "domains": ["hotspot.local"],
    "paths": ["/login"],
    "body_contains": ["hexMD5"],
    "priority": 50
  },
  "params": {
    "chap_detect": "hexMD5",
    "form_action": "http://${trm_domain}/login",
    "username_field": "username",
    "response_field": "response",
    "dst_field": "dst",
    "dst_default": "http://www.google.com",
    "success_check_type": "empty_body"
  }
}
