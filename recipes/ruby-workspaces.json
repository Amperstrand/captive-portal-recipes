{
  "id": "ruby-workspaces",
  "name": "Ruby Workspaces CHAP WiFi",
  "travelmate_domain": "hotspot.ruby-workspaces.com",
  "fallback_domains": [],
  "auth_type": "chap-md5",
  "credentials": "none",
  "match": {
    "ssids": [
      "Ruby Workspaces"
    ],
    "domains": [
      "hotspot.ruby-workspaces.com"
    ],
    "paths": [],
    "body_contains": [
      "hexMD5"
    ],
    "priority": 80
  },
  "params": {
    "chap_detect": "hexMD5",
    "form_action": "http://${trm_domain}/login",
    "username_field": "username",
    "response_field": "password",
    "dst_field": "dst",
    "dst_default": "",
    "success_check_type": "empty_body"
  }
}
