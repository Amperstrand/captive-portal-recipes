{
  "id": "dokom21-hotspot",
  "name": "Dokom21 Hotspot (DSW21/Westfalenhallen)",
  "travelmate_domain": "hotspot.dokom21.de",
  "fallback_domains": [],
  "auth_type": "form-submit",
  "credentials": "none",
  "match": {
    "ssids": [
      "DSW21-WLAN",
      "Hotspot Westfalenhallen"
    ],
    "domains": [
      "hotspot.dokom21.de"
    ],
    "paths": [],
    "body_contains": [],
