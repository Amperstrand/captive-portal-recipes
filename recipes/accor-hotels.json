{
  "id": "accor-hotels",
  "name": "Accor Hotels (m3connect)",
  "travelmate_domain": "welcome.m3connect.net",
  "fallback_domains": [],
  "auth_type": "multi-step-form",
  "credentials": "none",
  "match": {
    "ssids": [
      "ibisbudget",
      "movenpick",
      "BBHOTELSGuest",
      "-REWE gratis WLAN-",
      "-Kaufland FreeWiFi-"
    ],
    "domains": [
      "*.conn4.com"
    ],
    "paths": [
      "/ident"
    ],
    "body_contains": [
      "accor/i-accor/html-page-scene-wbs"
    ],
    "priority": 60
  },
  "params": {
    "success_check_type": "contains_string",
    "success_check_string": "online",
    "step1_url": "${trm_captiveurl}",
    "step1_name": "fetch landing page",
    "step1_extra_fields": "",
    "step2_url": "https://welcome.m3connect.net/en/step2",
    "step2_name": "submit room info",
    "step2_extra_fields": "room=101&adults=1",
    "step3_url": "https://welcome.m3connect.net/en/step3",
    "step3_name": "accept terms and connect",
    "step3_extra_fields": "terms=1&connect=1"
  }
}
