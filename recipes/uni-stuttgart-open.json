  "params": {
    "form_page_url": "${trm_captiveurl}",
    "submit_url": "https://${trm_domain}/login",
    "extra_fields": "accept=1",
    "username_field": "",
    "password_field": "",
    "form_action_default": "/login",
    "success_check_type": "empty_body"
  }
}
