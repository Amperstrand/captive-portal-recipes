#!/bin/sh
# mock-curl - Mock curl for travelmate recipe testing
# Returns appropriate responses based on MOCK_RECIPE env var and call counter
#shellcheck disable=all

COUNTER_FILE="/tmp/mock-curl-counter"
if [ -f "${COUNTER_FILE}" ]; then
	COUNT="$(cat "${COUNTER_FILE}")"
else
	COUNT=0
fi

# Parse curl arguments
URL=""
DATA=""
WRITE_OUT=""
COOKIE_JAR=""
OUTPUT_FILE=""
IS_POST=0

while [ $# -gt 0 ]; do
	case "$1" in
		--write-out) WRITE_OUT="$2"; shift 2 ;;
		--cookie-jar) COOKIE_JAR="$2"; shift 2 ;;
		--cookie) shift 2 ;;
		--output) OUTPUT_FILE="$2"; shift 2 ;;
		--data) DATA="$2"; IS_POST=1; shift 2 ;;
		--form-string) shift 2; IS_POST=1 ;;
		--header) shift 2 ;;
		--referer) shift 2 ;;
		--user-agent) shift 2 ;;
		--request) shift 2 ;;
		-sS|-s|-L) shift ;;
		--max-time|--connect-timeout) shift 2 ;;
		--*) shift 2 ;;
		-*) shift ;;
		*) URL="$1"; shift ;;
	esac
done

if [ -n "${MOCK_VERBOSE}" ]; then
	echo "  MOCK-CURL [${MOCK_RECIPE}] call#${COUNT}: $(if [ ${IS_POST} = 1 ]; then echo POST; else echo GET; fi) ${URL}" >&2
fi

RECIPE="${MOCK_RECIPE}"
BODY=""
WRITEOUT_VAL=""

# ── Handle --write-out requests (redirect URL extraction) ──
if [ -n "${WRITE_OUT}" ]; then
	case "${RECIPE}" in
		cisco-meraki)
			WRITEOUT_VAL="https://eu.network-auth.com/splash/?base_grant_url=https%3A%2F%2Feu.network-auth.com%2Fgrant"
			;;
		vodafone-de)
			WRITEOUT_VAL="http://hotspot.vodafone.de/portal/?sid=test_sid_123"
			;;
		*)
			WRITEOUT_VAL="https://portal.example.com/redirect"
			;;
	esac

# ── Handle --cookie-jar requests ──
	elif [ -n "${COOKIE_JAR}" ]; then
	# Write cookie jar in proper Netscape format: domain \t include_subdomains \t path \t secure \t expiry \t name \t value
	case "${RECIPE}" in
		wifibahn)
			printf 'wifi.bahn.de\tTRUE\t/\tFALSE\t0\tcsrf\ttest_csrf_token\n' > "${COOKIE_JAR}"
			;;
		wifipass)
			printf 'wifipass.org\tTRUE\t/\tFALSE\t0\tPHPSESSID\ttest_session_token\n' > "${COOKIE_JAR}"
			;;
		*)
			printf 'example.com\tTRUE\t/\tFALSE\t0\tsession\ttest_value\n' > "${COOKIE_JAR}"
			;;
	esac

# ── Handle POST requests ──
elif [ ${IS_POST} = 1 ]; then
	case "${RECIPE}" in
		# JSON API: single-call recipes
		t-mobile-hotspot)
			BODY='{"user":{"wlanLoginStatus":"connected"},"success":true}'
			;;
		targetbox|imaster-nce)
			BODY='{"success":true}'
			;;
		# JSON API: multi-call recipes
		commerzbank-wifi)
			case ${COUNT} in
				0) BODY='{"status":"ok"}' ;;
				1) BODY='{"info":{"subscribe":{"login":"testlogin","password":"testpass"}}}' ;;
				2) BODY='' ;;
			esac
			;;
		unwired-graphql)
			case ${COUNT} in
				0) BODY='{"data":{"splashpage":{"splashpage":{"pages":[{"widgets":[{"__typename":"ConnectWidget","widget_id":"widget_123"}]}]}}}}' ;;
				1) BODY='' ;;
			esac
			;;
		vodafone-de)
			BODY='{"success":true}'
			;;
		# Form-submit with contains_string success
		fortinet-clickthrough)
			BODY='keepalive'
			;;
		dokom21-hotspot)
			BODY='Login erfolgreich.'
			;;
		mist-portal|mypowerspot-de)
			BODY='success'
			;;
		unifi-guest)
			BODY='authorized'
			;;
		# Cookie-chain
		wifipass)
			BODY='success'
			;;
		# Multi-step-form: accor-hotels
		accor-hotels)
			if [ ${COUNT} = 5 ]; then
				BODY='online'
			fi
			;;
		# Multipart-post: fotoprofi-gast
		fotoprofi-gast)
			BODY='success'
			;;
		# Multi-api: conn4-rewe POST register
		conn4-rewe)
			BODY='{"success":true}'
			;;
		# Multi-api: socialwave-wifi POST register
		socialwave-wifi)
			BODY='{"AuthenticationToken":"test_token_abc"}'
			;;
		# js-parse: carglass-gast POST form
		carglass-gast)
			BODY=''
			;;
		# js-parse: fortinet-fgtauth POST form
		fortinet-fgtauth)
			BODY=''
			;;
		# multi-api: socialwibox POST redirectPost
		socialwibox)
			BODY=''
			;;
		# multi-api: ikea-wifi POST terms
		ikea-wifi)
			BODY=''
			;;
		# Default: empty body (for empty_body success check)
		*)
			BODY=''
			;;
	esac

# ── Handle GET requests ──
else
	case "${RECIPE}" in
		# Click-through-grant: second call returns empty
		cisco-meraki)
			BODY=''
			;;
		# CSRF: wifibahn doesn't have a standalone GET (handled by --cookie-jar)
		# JSON API: vodafone-de call 1 is session GET
		vodafone-de)
			BODY='{"session":"test_session_456","loginProfiles":[{"id":"4"}]}'
			;;
		# CHAP: need hexMD5 + chap-id/chap-challenge in HTML
		mikrotik-chap|ruby-workspaces)
			BODY='<html><body><script>function hexMD5(s){return s;}</script><form action="/login"><input type="hidden" name="chap-id" value="00"><input type="hidden" name="chap-challenge" value="aabbccdd"></form></body></html>'
			;;
		# JS redirect - use ""URL trick so the awk extraction works
		# (gsub(/.*"/, "", s) is greedy to last ", so URL must be after the last ")
		socialwifi)
			if [ ${COUNT} = 0 ]; then
				BODY='<html><body><script>window.location = ""https://success.example.com/auth</script></body></html>'
			else
				BODY=''
			fi
			;;
		# Multi-step-form: return HTML forms for step GETs (calls 0, 2, 4)
		accor-hotels)
			BODY='<html><body><form action="/step"><input type="hidden" name="token" value="abc123"></form></body></html>'
			;;
		# js-parse: blockhouse-wifi GET returns JS with variables, POST returns empty
		blockhouse-wifi)
			if [ ${COUNT} = 0 ]; then
				BODY='<html><script>var postToUrl = "/submit"; var port = "8080";</script></html>'
			else
				BODY=''
			fi
			;;
		# Multi-api: conn4-rewe - 3 calls (GET portal, GET scenes, POST register)
		conn4-rewe)
			case ${COUNT} in
				0) BODY='wbsToken=test_token_123&other=data' ;;
				1) BODY='tariff_free
tariff_premium' ;;
				2) BODY='{"success":true}' ;;
			esac
			;;
		# jwt-sign: abercrombie-wifi GET returns success response
		abercrombie-wifi)
			BODY='success'
			;;
		# js-parse: carglass-gast - returns JS with redirURL
		carglass-gast)
			if [ ${COUNT} = 0 ]; then
				BODY='<html><head><title>REDIR</title></head><body><script>var redirURL = "https://portal.carglass.de/auth";</script></body></html>'
			else
				BODY=''
			fi
			;;
		# js-parse: fortinet-fgtauth - returns JS with window.location
		fortinet-fgtauth)
			if [ ${COUNT} = 0 ]; then
				BODY='<html><body><script>window.location = "https://portal.fortinet.net/fgtauth?answer=1";</script></body></html>'
			else
				BODY=''
			fi
			;;
		# js-parse: cloudwifi-redirect - returns JS with FX_redirect vars
		cloudwifi-redirect)
			if [ ${COUNT} = 0 ]; then
				BODY='<html><body><script>var FX_redirect = new Array(); FX_redirect.0 = "AA:BB:CC:DD:EE:FF"; FX_redirect.1 = "11:22:33:44:55:66"; FX_redirect.2 = "https://start.cloudwifi.de/login";</script></body></html>'
			else
				BODY=''
			fi
			;;
		# multi-api: socialwibox - returns forms for multi-step
		socialwibox)
			case ${COUNT} in
				0) BODY='<html><body><form name="redirect" action="/step1"><input name="token" value="abc"><input type="submit"></form></body></html>' ;;
				1) BODY='<html><body><footer><span class="links-foot"><a href="/terms">Terms</a></span></footer></body></html>' ;;
				2) BODY='<html><body><script>function redirectPost() { redirectPost("https://portal.socialwibox.com/auth", {"token":"xyz"}); }</script></body></html>' ;;
				3) BODY='<html><body><form action="/final"><input name="session" value="final_session"></form></body></html>' ;;
				*) BODY='' ;;
			esac
			;;
		# multi-api: ikea-wifi - redirect + JSON credentials
		ikea-wifi)
			case ${COUNT} in
				0) BODY='' ;; # redirect
				1) BODY='{"payload":{"realm":"ikea","username":"user123","password":"pass456"}}' ;;
				*) BODY='' ;;
			esac
			;;
		# multi-api: socialwave-wifi - multi-step API calls
		socialwave-wifi)
			case ${COUNT} in
				0) BODY='res=notyet&auth=192.168.1.1' ;;
				1) BODY='{"Settings":{"RedirectUrl":"https://example.com"}}' ;;
				2) BODY='{"AuthenticationToken":"test_token_abc"}' ;;
				*) BODY='' ;;
			esac
			;;
		# Multipart-post: fotoprofi-gast returns HTML with hidden redirect field
		fotoprofi-gast)
			BODY='<html><body><form action="/wgcgi.cgi"><input type="hidden" name="redirect" value="http://original.url/"></form></body></html>'
			;;
		# JSON API: these start with POST, no initial GET
		t-mobile-hotspot|targetbox|imaster-nce|unwired-graphql|commerzbank-wifi)
			BODY=''
			;;
		# Default form-submit: HTML with form + hidden fields
		*)
			BODY='<html><body><form action="/login"><input type="hidden" name="token" value="abc123"></form></body></html>'
			;;
	esac
fi

# ── Output ──
if [ -n "${OUTPUT_FILE}" ] && [ "${OUTPUT_FILE}" != "/dev/null" ]; then
	printf '%s' "${BODY}" > "${OUTPUT_FILE}"
elif [ -z "${OUTPUT_FILE}" ]; then
	printf '%s' "${BODY}"
fi

if [ -n "${WRITE_OUT}" ] && [ -n "${WRITEOUT_VAL}" ]; then
	printf '%s' "${WRITEOUT_VAL}"
fi

# Increment counter
echo $((COUNT + 1)) > "${COUNTER_FILE}"
